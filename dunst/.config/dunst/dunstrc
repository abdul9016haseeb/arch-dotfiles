[global]
    monitor = 0
    follow = none

    ### Geometry ###
    width = (0, 320)
    height = (0, 200)
    origin = top-right
    offset = (15, 60)        # sits just below your Waybar
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4
    progress_bar_corners = all

    ### Icon ###
    icon_corner_radius = 6
    icon_corners = all

    indicate_hidden = yes
    transparency = 0

    ### Spacing ###
    separator_height = 0      # disabled — we use gap_size instead
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10

    ### Frame (border) ###
    frame_width = 2
    frame_color = "#313244"

    ### Gap between notifications ###
    gap_size = 8

    separator_color = frame

    sort = urgency_descending

    ### Text ###
    font = JetBrainsMono Nerd Font 10

    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no       # cleaner look without U/A indicators

    enable_posix_regex = true

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita"
    ###icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/wofi -d -p dunst:    # using wofi instead of dmenu
    browser = /usr/bin/xdg-open
    always_run_script = true
    corner_radius = 12                    # rounded corners like your Waybar
    corners = all

    ### Wayland ###
    layer = top
    force_xwayland = false

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true    # pause on hover — useful on Wayland

[urgency_low]
    background = "#1e1e2e"
    foreground = "#6c7086"
    frame_color = "#313244"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"       # soft blue accent — stands out on black
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"       # red accent for critical
    timeout = 0
    default_icon = dialog-warning
